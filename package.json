{
  "name": "noyacg-mcp",
  "version": "0.1.0",
  "description": "noymanga.com 的 MCP server：给 AI agent 用的社区 / 图床 / 签到 / 徽章工具（浏览器登录自动抓 Cookie）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "noyacg-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "login": "node dist/index.js login",
    "status": "node dist/index.js status",
    "logout": "node dist/index.js logout"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "noymanga",
    "noyacg",
    "manga",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
